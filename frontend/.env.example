# Adres gatewaya, na który dev-server Vite proxuje /v1 i /api
GATEWAY_URL=http://localhost:8000
# true = mocki dla endpointów, których backend jeszcze nie ma. Czat (/v1/chat/completions) i tak idzie na żywy gateway.
VITE_USE_MOCKS=true
# Opcjonalnie: nadpisuje listę funkcji wołających żywy gateway (domyślnie: chat).
# Pusta wartość = wszystko na mockach (praca offline bez backendu).
# VITE_LIVE_FEATURES=
# Tagi modeli dla Playground, dopóki gateway nie wystawi GET /api/models (zgodne z backend application.yml)
VITE_MODELS=qwen2.5:1.5b-instruct-q4_K_M,qwen2.5:0.5b
